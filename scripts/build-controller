#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
target_dir="${CARGO_TARGET_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-localsend/target}"
asset="localsend-controller-x86_64-unknown-linux-gnu"

CARGO_TARGET_DIR="$target_dir" cargo build \
  --locked \
  --release \
  --manifest-path "$repo_root/controller/Cargo.toml"

install -D -m 0755 \
  "$target_dir/release/localsend-controller" \
  "$repo_root/dist/$asset"

digest="$(sha256sum "$repo_root/dist/$asset")"
printf '%s  %s\n' "${digest%% *}" "$asset" > "$repo_root/dist/$asset.sha256"
printf 'Built %s\n' "$repo_root/dist/$asset"
